# BebrasCuba — Docker Compose (desarrollo)
# Copia a .env en la raíz del repo si hace falta: copy .env.docker.example .env

DB_DATABASE=bebrascuba
DB_USERNAME=postgres
DB_PASSWORD=secret

# Puerto de Postgres en el host (evita conflicto con Laragon en 5432)
DB_HOST_PORT=5433

# Opcional: automatizaciones al arrancar backend
AUTO_MIGRATE=false
AUTO_SEED=false
SEED_EDICION_2025=false
